{
  "id": "credit-card-payment-tracker",
  "name": "Credit Card & Payment Tracker",
  "version": "1.1.0",
  "description": "Due dates, statement balances, utilization alerts, and payable accounts for Wealthfolio",
  "author": "Vamsi Charan Adari",
  "main": "dist/addon.js",
  "sdkVersion": "3.13.1",
  "minWealthfolioVersion": "3.13.1",
  "enabled": true,
  "contributes": {
    "routes": [
      {
        "id": "credit-card-payment-tracker"
      }
    ],
    "links": {
      "sidebar": [
        {
          "id": "credit-card-payment-tracker",
          "route": "credit-card-payment-tracker",
          "label": "Card Payments",
          "icon": "credit-card",
          "order": 100
        }
      ]
    }
  },
  "hostDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "@wealthfolio/addon-sdk": "^3.8.0",
    "@wealthfolio/ui": "^3.8.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "permissions": [
    {
      "category": "accounts",
      "functions": ["getAll"],
      "purpose": "Load and display checking and credit card accounts"
    },
    {
      "category": "portfolio",
      "functions": ["getLatestValuations"],
      "purpose": "Load live account valuations and balances"
    },
    {
      "category": "activities",
      "functions": ["create"],
      "purpose": "Record bill payment transfers between checking and credit cards"
    },
    {
      "category": "storage",
      "functions": ["get", "set", "remove"],
      "purpose": "Persist card payment metadata, due dates, credit limits, and settings across browser sessions"
    }
  ]
}
